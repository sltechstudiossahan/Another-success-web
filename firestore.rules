rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /nicVerifications/{uid} {
      // Any signed-in user can read another user's verified NIC — this is
      // what powers "show NIC details for senders not in your contacts."
      allow read: if request.auth != null;

      // No client writes, ever. Only the confirmNicVerification Cloud
      // Function (Admin SDK, bypasses these rules) can write here.
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == uid
        // nicVerified / nicVerifiedAt may only change via the Cloud
        // Function's merge write, never directly by the client.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nicVerified', 'nicVerifiedAt']);
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Only status (read receipts) may be updated, and only by a participant.
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }
    }

    match /typingStatus/{chatId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // each user only ever sets their own uid key client-side
    }
  }
}
